skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #33475B
skinparam ArrowFontSize 11
skinparam sequence {
  ArrowColor #33475B
  LifeLineBorderColor #8FA3B8
  LifeLineBackgroundColor #EEF2F7
  ParticipantBorderColor #33475B
  ParticipantBackgroundColor #EEF2F7
  ParticipantFontColor #1A2733
  ActorBorderColor #33475B
  ActorBackgroundColor #EEF2F7
  GroupBorderColor #8FA3B8
  GroupBackgroundColor #FBFCFD
  DividerBackgroundColor #EEF2F7
  DividerBorderColor #8FA3B8
}
skinparam database {
  BackgroundColor #D9E8F5
  BorderColor #2C6FAF
}
skinparam note {
  BackgroundColor #FFF9E3
  BorderColor #C9A227
}

' --- component-diagram styling (shared with the sequence diagrams above) ---
skinparam componentStyle uml2
skinparam linetype ortho
skinparam defaultTextAlignment center
skinparam ArrowFontColor #33475B
skinparam package {
  BackgroundColor #FBFCFD
  BorderColor #8FA3B8
  FontColor #33475B
  FontStyle bold
}
skinparam component {
  BackgroundColor #EEF2F7
  BorderColor #33475B
  FontColor #1A2733
}
skinparam folder {
  BackgroundColor #EEF2F7
  BorderColor #33475B
}
skinparam file {
  BackgroundColor #FBFCFD
  BorderColor #8FA3B8
}
