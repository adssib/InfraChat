@startuml final-architecture
' InfraChat — Final architecture: every component, coloured by the phase that introduced it
' Contracts: docs/SPEC.md ("Contracts") · Build order: docs/ROADMAP.md
' Render: plantuml -tpng final-architecture.puml

title InfraChat — Final Architecture\n<size:12>offline ingestion · online query · the eval harness across the whole pipeline</size>

skinparam shadowing false
skinparam componentStyle uml2
skinparam linetype ortho
skinparam defaultTextAlignment center
skinparam ArrowColor #33475B
skinparam ArrowFontColor #33475B
skinparam ArrowFontSize 11
skinparam package {
  BackgroundColor #FBFCFD
  BorderColor #8FA3B8
  FontColor #33475B
  FontStyle bold
}
skinparam component {
  BackgroundColor #EEF2F7
  BorderColor #33475B
  FontColor #1A2733
}
skinparam folder {
  BackgroundColor #EEF2F7
  BorderColor #33475B
}
skinparam database {
  BackgroundColor #EEF2F7
  BorderColor #33475B
}

package "OFFLINE — ingestion (batch: infrachat ingest)" as OFFLINE {
  folder "Cloned corpus\n(kubernetes/website + docker/docs)\npinned commit" as Corpus #EEF2F7
  component "Corpus Loader" as Loader #EEF2F7
  component "Filter" as Filter #EEF2F7
  component "Chunker" as Chunker #EEF2F7
  component "Embedder" as Embedder <<seam>> #EEF2F7
  database  "Vector Store" as VectorStore <<seam>> #EEF2F7
  database  "Keyword Index\n(BM25)" as KeywordIndex <<seam>> #C8E6C9
}

package "ONLINE — query (per request: infrachat ask / serve)" as ONLINE {
  component "Query" as Query #EEF2F7
  component "Query Rewriter" as Rewriter <<seam>> #D1C4E9
  component "LLM — rewriter\n(small / cheap model)" as LLMRewriter <<seam>> #D1C4E9

  package "Hybrid Retriever — the Retriever seam" as HYBRID {
    component "Dense Retriever" as Retriever <<seam>> #EEF2F7
    component "Fusion\n(reciprocal rank fusion)" as Fusion #C8E6C9
  }

  component "Reranker\n(cross-encoder)" as Reranker <<seam>> #FFE0B2
  component "Grounding Gate" as Gate <<gate>> #EEF2F7
  component "Prompt Builder" as Prompt #EEF2F7
  component "LLM — generator" as LLM <<seam>> #EEF2F7
  component "Citation Check" as CiteCheck <<gate>> #EEF2F7
  component "Answer + citations" as Answer #A9DFBF
  component "REFUSE (below floor)\nNot found in the\nKubernetes or Docker docs." as RefuseFloor #F5B7B1
  component "REFUSE (not grounded)\nInsufficient grounding\nto answer." as RefuseNotInDocs #F5B7B1
}

package "CROSS-CUTTING" as XCUT {
  component "Eval Harness" as Eval <<eval>> #D7BDE2
  file "comparison table\nbaseline · +reranker · +hybrid · +rewriter" as EvalReport #D7BDE2
  file "config.yaml\nthe experiment knobs" as Config #FBFCFD
}

' ---- OFFLINE: walk, filter, chunk, index two ways ----
Corpus      --> Loader       : markdown files\n(k8s + docker trees)
Loader      --> Filter       : candidate files
Filter      --> Chunker      : allowed docs\n(secrets / binaries / oversized dropped)
Chunker     --> Embedder     : chunks + provenance\n(source, source_doc, source_location)
Embedder    --> VectorStore  : chunk vectors
Chunker     --> KeywordIndex : the SAME chunks, tokenized\n(BM25 postings)

' ---- ONLINE: rewrite -> retrieve -> fuse -> rerank -> gate -> generate -> verify ----
Query        --> Rewriter     : raw question
Rewriter     ..> LLMRewriter  : rewrite prompt
LLMRewriter  --> Rewriter     : rewritten / expanded query
Rewriter     --> Retriever    : rewritten query
Retriever    ..> Embedder     : embeds the query\n(same seam as ingestion)
Retriever    ..> VectorStore  : query vector, retrieve_n=20
VectorStore  --> Retriever    : dense top-20 (ranked)
Retriever    ..> KeywordIndex : query terms, retrieve_n=20
KeywordIndex --> Fusion       : keyword top-20 (ranked)
Retriever    --> Fusion       : dense top-20 (ranked)
Fusion       --> Reranker     : fused top-20 (RRF)
Reranker     --> Gate         : reranked top-5
Gate         --> RefuseFloor  : REFUSAL 1 — top-1 score < floor (F8)
Gate         --> Prompt       : hits above floor
Prompt       --> LLM          : grounded prompt\n(excerpts only, no outside knowledge)
LLM          --> CiteCheck    : raw completion
CiteCheck    --> Answer       : answer text + [source:location]\ncitations (F9/F10)
CiteCheck    --> RefuseNotInDocs : REFUSAL 2 — LLM emitted NOT_IN_DOCS,\nor answer carries no matchable citation

' ---- CROSS-CUTTING: the eval harness spans both paths ----
Eval            ..> Corpus  : pins the corpus commit\n(so runs are comparable)
Eval            ..> Query   : one fixed question set\nk8s-answerable / docker-answerable / should-refuse
Reranker        ..> Eval    : retrieval hit-rate
Rewriter        ..> Eval    : added latency + token cost
Answer          ..> Eval    : grounding + citation correctness
RefuseFloor     ..> Eval    : refusal correctness
RefuseNotInDocs ..> Eval    : refusal correctness
Eval            --> EvalReport : one row per run_label

' ---- the config is the experiment (one edge; the knobs are listed on it) ----
Config ..> ONLINE : toggles every optional seam —\nrewrite.enabled · hybrid.enabled · rerank.enabled\nand tunes floor · k · retrieve_n

note as FinalNote #FFF9E3
  **The gate never moved.**
  Every component added across Phases 2-4 changes only
  //what reaches// the grounding gate — never the gate itself.
  The two refusal paths (**score below floor**, F8, and
  **NOT_IN_DOCS / uncited**, F9) are Phase 1 code that
  every later phase still runs unchanged.
  That invariant is what makes the A/B comparisons honest.
end note
FinalNote .. Gate

legend right
  |= |= component colour = the phase that introduced it |
  |<#EEF2F7>   | **Phase 1** — baseline RAG |
  |<#FFE0B2>   | **Phase 2** — cross-encoder reranker |
  |<#C8E6C9>   | **Phase 3** — hybrid search (BM25 + RRF) |
  |<#D1C4E9>   | **Phase 4** — query rewriter |
  |= |= role |
  |<#F5B7B1>   | refusal path (Phase 1) |
  |<#A9DFBF>   | answer rendered to the user (Phase 1) |
  |<#D7BDE2>   | eval harness — the spine, Phase 1 |
  |= |= arrow |
  | —▶ | data flowing through the pipeline |
  | ┄▶ | lookup into a seam / config / eval instrumentation |
  | «seam» | pluggable interface — SPEC "Contracts" |
endlegend

@enduml
