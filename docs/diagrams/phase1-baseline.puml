@startuml phase1-baseline
' InfraChat — Phase 1: Baseline RAG (ingest -> embed -> store; retrieve -> ground -> answer)
' Contracts: docs/SPEC.md ("Contracts") · Build order: docs/ROADMAP.md
' Render: plantuml -tpng phase1-baseline.puml

title InfraChat — Phase 1: Baseline RAG\n<size:12>dense retrieval, grounding gate, cited answer or refusal</size>

skinparam shadowing false
skinparam componentStyle uml2
skinparam linetype ortho
skinparam defaultTextAlignment center
skinparam ArrowColor #33475B
skinparam ArrowFontColor #33475B
skinparam ArrowFontSize 11
skinparam package {
  BackgroundColor #FBFCFD
  BorderColor #8FA3B8
  FontColor #33475B
  FontStyle bold
}
skinparam component {
  BackgroundColor #EEF2F7
  BorderColor #33475B
  FontColor #1A2733
}
skinparam folder {
  BackgroundColor #EEF2F7
  BorderColor #33475B
}
skinparam database {
  BackgroundColor #EEF2F7
  BorderColor #33475B
}

package "OFFLINE — ingestion (batch: infrachat ingest)" as OFFLINE {
  folder "Cloned corpus\n(kubernetes/website + docker/docs)" as Corpus
  component "Corpus Loader" as Loader
  component "Filter" as Filter
  component "Chunker" as Chunker
  component "Embedder" as Embedder <<seam>>
  database  "Vector Store" as VectorStore <<seam>>
}

package "ONLINE — query (per request: infrachat ask)" as ONLINE {
  component "Query" as Query
  component "Dense Retriever" as Retriever <<seam>>
  component "Grounding Gate" as Gate <<gate>>
  component "Prompt Builder" as Prompt
  component "LLM — generator" as LLM <<seam>>
  component "Citation Check" as CiteCheck <<gate>>
  component "Answer + citations" as Answer #A9DFBF
  component "REFUSE (below floor)\nNot found in the\nKubernetes or Docker docs." as RefuseFloor #F5B7B1
  component "REFUSE (not grounded)\nInsufficient grounding\nto answer." as RefuseNotInDocs #F5B7B1
}

package "CROSS-CUTTING" as XCUT {
  component "Eval Harness" as Eval <<eval>> #D7BDE2
  file "eval scores\nhit-rate · grounding · refusal" as EvalReport #D7BDE2
}

' ---- offline: ingestion data flow ----
Corpus      --> Loader      : markdown files\n(k8s + docker trees)
Loader      --> Filter      : candidate files
Filter      --> Chunker     : allowed docs\n(secrets / binaries / oversized dropped)
Chunker     --> Embedder    : chunks + provenance\n(source, source_doc, source_location)
Embedder    --> VectorStore : chunk vectors

' ---- online: query data flow ----
Query       --> Retriever   : question
Retriever   ..> Embedder    : embeds the query\n(same seam as ingestion)
Retriever   ..> VectorStore : query vector, k=5
VectorStore --> Retriever   : top-5 chunks\n(score, source, location)
Retriever   --> Gate        : top-5 Retrieved
Gate        --> RefuseFloor : REFUSAL 1 — top-1 score < floor (F8)
Gate        --> Prompt      : hits above floor
Prompt      --> LLM         : grounded prompt\n(excerpts only, no outside knowledge)
LLM         --> CiteCheck   : raw completion
CiteCheck   --> Answer      : answer text + [source:location]\ncitations (F9/F10)
CiteCheck   --> RefuseNotInDocs : REFUSAL 2 — LLM emitted NOT_IN_DOCS,\nor answer carries no matchable citation

' ---- cross-cutting: eval instrumentation ----
Eval            ..> Query   : fixed question set\n(k8s / docker / should-refuse)
Retriever       ..> Eval    : retrieved hits\n(retrieval hit-rate)
Answer          ..> Eval    : grounded answers
RefuseFloor     ..> Eval    : refusals
RefuseNotInDocs ..> Eval    : refusals
Eval            --> EvalReport : scores tagged run_label\n→ the Phase 1 BASELINE

note as SeamNote #FFF9E3
  **The seams that are not yet used still exist.**
  Phase 1 runs the //same// pipeline as every later phase,
  with the optional components wired as **null objects**:
  identity ""QueryRewriter"", dense-only ""Retriever"",
  pass-through ""Reranker"".
  Later phases swap one implementation — they never rewire.
end note
SeamNote .. Retriever

legend right
  |<#EEF2F7>   | carried over from an earlier phase |
  |<#FFD98E>   | **NEW in this phase** |
  |<#F5B7B1>   | refusal path |
  |<#A9DFBF>   | answer rendered to the user |
  |<#D7BDE2>   | eval harness (cross-cutting) |
  | —▶ | data flowing through the pipeline |
  | ┄▶ | lookup into a seam / eval instrumentation |
  | «seam» | pluggable interface — SPEC "Contracts" |
endlegend

@enduml
